<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase_sale_inter_company.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='sync_picking']" position="after">
                <div attrs="{'invisible': [('sync_picking', '=', False)]}">
                    <field name="sync_picking_transit_receipt" class="oe_inline" />
                    <label
                        string="Through the transit receipt"
                        class="o_light_label"
                        for="sync_picking_transit_receipt"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
